---
import { giscus } from '../config'

interface Props {
  /** 区块标题，文章页为「评论」，留言页为「留言」 */
  title?: string
  category?: string
  categoryId?: string
  mapping?: 'pathname' | 'specific'
  /** mapping=specific 时必填，固定讨论标识 */
  term?: string
}

const {
  title = '评论',
  category = giscus.comments.category,
  categoryId = giscus.comments.categoryId,
  mapping = 'pathname',
  term,
} = Astro.props

const enabled = Boolean(giscus.repo && giscus.repoId && categoryId)

const termAttribute = term ? `data-term="${term}"` : ''

/**
 * 用 set:html 注入原始 script 标签。
 *
 * 直接写 <script src="https://giscus.app/client.js"> 会被 Astro 当成模块解析，
 * 报 “Cannot find package 'https:'”。set:html 让这段 HTML 原样输出，不经过打包器。
 */
const giscusHtml = `<script src="https://giscus.app/client.js"
  data-repo="${giscus.repo}"
  data-repo-id="${giscus.repoId}"
  data-category="${category}"
  data-category-id="${categoryId}"
  data-mapping="${mapping}"
  ${termAttribute}
  data-strict="0"
  data-reactions-enabled="1"
  data-emit-metadata="0"
  data-input-position="${giscus.inputPosition}"
  data-theme="${giscus.theme}"
  data-lang="zh-CN"
  crossorigin="anonymous"
  async></script>`
---

<section class="comments">
  <h2 class="panel__title">{title}</h2>

  {
    enabled ? (
      <div set:html={giscusHtml} />
    ) : (
      <p class="hint muted">评论功能待配置 Giscus 后启用。</p>
    )
  }
</section>

<script is:inline>
  /*
   * Giscus 渲染在跨域 iframe 里，外部 CSS 改不到它，只能通过 postMessage
   * 让它跟着站点的「常规 / 夜间」切换主题。高对比版本是为了让
   * "n 条评论 / n 个表情" 这类小字在两种模式下都足够清楚。
   */
  (() => {
    const themeFor = () =>
      document.documentElement.dataset.theme === 'dark' ? 'dark_high_contrast' : 'light_high_contrast'

    const apply = () => {
      const frame = document.querySelector('iframe.giscus-frame')
      if (!frame) return
      frame.contentWindow.postMessage(
        { giscus: { setConfig: { theme: themeFor() } } },
        'https://giscus.app',
      )
    }

    // iframe 由 giscus 脚本异步插入，前几秒反复尝试，确保配置消息送达
    let tries = 0
    const timer = setInterval(() => {
      apply()
      if (++tries >= 20) clearInterval(timer)
    }, 300)

    // 用户点击导航栏的切换按钮后立即同步
    window.addEventListener('kdr:themechange', apply)
  })()
</script>

<style>
  .comments {
    margin-top: 0;
    padding-top: 0;
  }

  .hint {
    margin: 0;
    font-size: 0.86rem;
  }

  /*
   * Giscus 由外部脚本注入 div.giscus + iframe，不受组件 scoped 样式约束，
   * 必须用 :global。整体收窄 16px 并居中，避免边框贴边/溢出。
   */
  .comments :global(.giscus) {
    width: calc(100% - 16px);
    margin: 0 auto;
  }

  .comments :global(.giscus-frame) {
    display: block;
    width: 100% !important;
    max-width: 100%;
    border: none;
  }
</style>
